# Dossier public (photos de profil, articles…). L'upload (app/Core/Upload.php)
# ne valide que de vraies images (getimagesize) et renomme aléatoirement les
# fichiers, mais on désactive quand même toute exécution de code ici en
# défense en profondeur (au cas où un fichier malveillant y parviendrait).

Options -Indexes -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .jsp .asp .sh .cgi

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d|phtml|pl|py|jsp|asp|sh|cgi)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---- Jamais de copie en cache (plan PWA §5.2) ----
# Ce dossier est MIXTE : photos de profil privées et photos d'albums publics.
# Le Service Worker ne l'intercepte pas (réseau seul) et aucun cache HTTP ne
# doit en conserver une copie : une image privée ne doit pas survivre dans le
# cache d'un appareil partagé, ni apparaître dans un cache hors ligne.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private"
  Header always set Pragma "no-cache"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
