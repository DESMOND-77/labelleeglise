# Copiez ce fichier en `.env` (jamais versionné) et adaptez les valeurs
# à votre environnement. Le fichier `.env` est chargé par
# Bootstrap/env.php ; les vraies variables d'environnement du serveur
# (Apache/PHP-FPM, panneau d'hébergement) restent toujours prioritaires
# sur ce fichier.

# --- Base de données (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=la_belle_eglise_db
DB_USER=change_me
DB_PASS=change_me
DB_CHARSET=utf8mb4

# --- Application ---
APP_NAME="La Belle Église"
# Saisir un domaine réel HTTPS pour les redirections et liens d’email.
APP_URL="https://example.com/"
APP_TIMEZONE=Africa/Libreville
APP_DEBUG=false
APP_SESSION_NAME=LBEGF_SESSID
APP_UPLOAD_DIR=uploads
APP_MAX_UPLOAD_BYTES=4194304

# --- SMTP (envoi d'emails via PHPMailer) ---
# Laisser SMTP_HOST vide désactive l'envoi réel : les emails sont
# journalisés dans Storage/logs/mail.log sans jamais bloquer
# l'inscription, la vérification ou l'activation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="La Belle Église"
APP_BASE_URL="https://example.com/"
SMTP_DEBUG=false
