# Copiez ce fichier en `.env` (jamais versionné) et adaptez les valeurs
# à votre environnement. Le fichier `.env` est chargé par
# Bootstrap/env.php ; les vraies variables d'environnement du serveur
# (Apache/PHP-FPM, panneau d'hébergement) restent toujours prioritaires
# sur ce fichier.

# --- Base de données (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=la_belle_eglise_db
DB_USER=change_me
DB_PASS=change_me
DB_CHARSET=utf8mb4
# Collation de la connexion = celle des tables (migration). Doit appartenir à DB_CHARSET, sinon ignorée.
DB_COLLATION=utf8mb4_unicode_ci

# --- Application ---
APP_NAME="La Belle Église Intenationale Franceville"
# Saisir un domaine réel HTTPS pour les redirections et liens d’email.
APP_URL="https://example.com/"
APP_TIMEZONE=Africa/Libreville
APP_DEBUG=false
APP_SESSION_NAME=LBEGF_SESSID
APP_UPLOAD_DIR=uploads
APP_MAX_UPLOAD_BYTES=4194304

# --- SMTP (envoi d'emails via PHPMailer) ---
# Laisser SMTP_HOST vide désactive l'envoi réel : les emails sont
# journalisés dans Storage/logs/mail.log sans jamais bloquer
# l'inscription, la vérification ou l'activation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="La Belle Église Intenationale Franceville"
APP_BASE_URL="https://example.com/"
SMTP_DEBUG=false

# --- PWA / mode hors ligne (Config/pwa.php) ---
# Couper toute la PWA (manifeste, Service Worker, endpoints, scripts).
PWA_ENABLED=true
# Saisie et brouillons hors ligne (indépendant de l'installation PWA).
PWA_OFFLINE_CAPTURE=true
# Service Worker + caches statiques de la vitrine.
PWA_SERVICE_WORKER=true
# Coffre local : simple (clé appareil) ou pin (code PIN / phrase secrète,
# recommandé sur appareil partagé). Voir docs/plans/pwa-offline-sync-*.
PWA_VAULT_MODE=simple
# Durée de conservation locale des brouillons (jours).
PWA_RETENTION_DAYS=7
# Déconnexion avec saisies en attente : ask | keep | purge.
PWA_LOGOUT_POLICY=ask
# Opérations autorisées hors connexion (rollback unitaire).
PWA_OP_RAPPORT_JOUR=true
PWA_OP_SUIVI_HEBDO=true
PWA_OP_PUBLIC_REGISTER=true
